# =======================================================
# CAMPUSHUB PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Use this template for Vercel environment variables.
# =======================================================

# Server Environment
NODE_ENV=production
PORT=5000

# CORS Whitelist: Actual GitHub Pages frontend origin (no trailing slash)
FRONTEND_ORIGIN=https://amit470-singh.github.io

# Supabase PostgreSQL Database Connection URL
# From Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Max database connections in pool (Recommended: 3-5 for Vercel serverless / Supabase Transaction Pooler)
DB_POOL_MAX=5

# JWT Authentication Secret (Must be a secure random 32+ character string in production)
JWT_SECRET=generate-a-secure-random-32-char-string-here-12345
JWT_EXPIRES_IN=7d

# Real Gmail / Custom SMTP Configuration for Email OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM="CampusHub <your-email@gmail.com>"
